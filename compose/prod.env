# --- SockShop PRODUCTION stage ----------------------------------------------
# Used as: docker compose -p sockshop-prod --env-file prod.env -f docker-compose.sockshop.yml up -d
COMPOSE_PROJECT_NAME=sockshop-prod
STAGE=prod
FRONTEND_PORT=8081
# Known-good production image (glibc -> monitored). Self-healing / rollback restores this tag.
CARTS_IMAGE=dynatracesockshop/carts:0.5.0
CARTS_VERSION=1.2
