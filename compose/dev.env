# --- SockShop DEV / staging stage -------------------------------------------
# Used as: docker compose -p sockshop-dev --env-file dev.env -f docker-compose.sockshop.yml up -d
COMPOSE_PROJECT_NAME=sockshop-dev
STAGE=dev
FRONTEND_PORT=8079
# Good build by default (glibc image -> OneAgent injects cleanly, carts is monitored).
# The Jenkins "bad build" path layers carts-badbuild.override.yml on top instead of swapping tags.
CARTS_IMAGE=dynatracesockshop/carts:0.5.0
CARTS_VERSION=2.3
