# --- SockShop DEV / staging stage -------------------------------------------
# Used as: docker compose -p sockshop-dev --env-file dev.env -f docker-compose.sockshop.yml up -d
COMPOSE_PROJECT_NAME=sockshop-dev
STAGE=dev
FRONTEND_PORT=8079
# Good build by default; the Jenkins pipeline overrides CARTS_IMAGE for the canary/bad build.
CARTS_IMAGE=wmsegar/carts:1.0
CARTS_VERSION=2.3
