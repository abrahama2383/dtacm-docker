# Copy to .env and edit for your VM:  cp .env.example .env
# -----------------------------------------------------------------------------

# Absolute path of THIS project on the VM. Used for docker bind mounts
# (Jenkins -> /dtacm, and JMeter loadtest volume). REQUIRED.
DTACM_HOST_PATH=/opt/dtacm-docker

# GID of the host "docker" group so the Jenkins container can use the socket:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Jenkins admin login (bootstrapped by JCasC)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin
JENKINS_URL=http://localhost:8080/

# --- Dynatrace (optional; needed only for quality gate + self-healing) -------
# SaaS:    https://<envid>.live.dynatrace.com
# Managed: https://<host>/e/<envid>
DT_TENANT_URL=
DT_API_TOKEN=
# OneAgent install (see dynatrace/README.md) - PaaS token + tenant for the agent
DT_PAAS_TOKEN=
DT_ONEAGENT_INSTALLER_URL=

# Where AWX reaches the host-published prod carts (auto-detected if blank)
HOST_IP=
CARTS_PUBLISH_PORT=8091
